# Tio Clem — Content Factory : variables d'environnement
# Copier ce fichier en .env et remplir seulement ce que tu utilises.
# Ne jamais committer .env (il est ignoré par git). Aucune clé n'est écrite dans le code.

# ---------------------------------------------------------------- Mode test
# MOCK=1 active les fournisseurs factices pour tester la chaîne sans API.
# Une publication produite avec un asset MOCK reste toujours NEEDS_REVIEW.
MOCK=0

# ---------------------------------------------------------------- Voix off (Phase 3)
# none       : pas de TTS, voix enregistrée par Tio Clem (recommandé, aucun coût)
# piper      : TTS local open source (gratuit, modèle français à télécharger)
# openai     : API OpenAI TTS (payant)
# elevenlabs : API ElevenLabs (payant)
# azure      : Azure AI Speech (payant, offre gratuite limitée)
# mock       : tests uniquement
TTS_PROVIDER=none
TTS_VOICE=
PIPER_MODEL_PATH=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------------------------------------------------------------- Images générées (Phase 3, Mode B)
# none      : cartes graphiques Tio Clem + tes photos (aucun coût)
# openai    : génération d'images OpenAI (payant)
# replicate : modèles open source hébergés (payant à l'usage)
# mock      : tests uniquement
IMAGE_PROVIDER=none
REPLICATE_API_TOKEN=

# ---------------------------------------------------------------- Rendu
# Chemin vers une police emoji couleur si le système n'en a pas (ex. NotoColorEmoji.ttf).
TIOCLEM_EMOJI_FONT=
# Chemin vers ffmpeg ; vide = ffmpeg du système, sinon celui d'imageio-ffmpeg.
FFMPEG_PATH=
