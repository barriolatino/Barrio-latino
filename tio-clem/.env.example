# Tio Clem — Content Factory : variables d'environnement
# Copier ce fichier en .env et remplir seulement ce que tu utilises.
# Ne jamais committer .env (il est ignoré par git). Aucune clé n'est écrite dans le code.

# ---------------------------------------------------------------- Mode test
# MOCK=1 active les fournisseurs factices pour tester la chaîne sans API.
# Une publication produite avec un asset MOCK reste toujours NEEDS_REVIEW.
MOCK=0

# ---------------------------------------------------------------- Voix off
# Ta voix enregistrée (assets/audio/voice/day-NN.m4a) passe toujours en premier.
# none       : pas de synthèse (recommandé, aucun coût)
# piper      : TTS local open source, gratuit (pip install piper-tts + modèle français .onnx)
# openai     : API OpenAI /v1/audio/speech (payant)
# elevenlabs : API ElevenLabs (payant)
# mock       : tests uniquement, bloque READY_TO_PUBLISH
# État : none et mock testés ; piper, openai et elevenlabs codés d'après la documentation
# officielle mais jamais testés contre le vrai service (réseau bloqué pendant le développement).
TTS_PROVIDER=none
# openai : voix (coral, marin, cedar, alloy…) et modèle (gpt-4o-mini-tts par défaut)
TTS_VOICE=
TTS_MODEL=
PIPER_MODEL_PATH=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------- Images générées (Mode B)
# Seules les scènes marquées "asset_type": "generated" sont générées ; les autres restent
# des cartes Tio Clem, tes photos ou des images sourcées (Mode A).
# none   : aucune génération (aucun coût)
# openai : API OpenAI /v1/images/generations, 1024x1536 (payant) — jamais testé en réel
# mock   : tests uniquement, bloque READY_TO_PUBLISH
IMAGE_PROVIDER=none
IMAGE_MODEL=
# low, medium ou high (coût croissant)
IMAGE_QUALITY=

# ---------------------------------------------------------------- Rendu
# Chemin vers une police emoji couleur si le système n'en a pas (ex. NotoColorEmoji.ttf).
TIOCLEM_EMOJI_FONT=
# Chemin vers ffmpeg ; vide = ffmpeg du système, sinon celui d'imageio-ffmpeg.
FFMPEG_PATH=
