{
  "name": "tio-clem-content-factory",
  "version": "2.0.0",
  "private": true,
  "description": "Tio Clem : production semi-autonome de publications TikTok sur le Pérou (moteur Python, commandes Claude Code).",
  "scripts": {
    "setup": "bash setup.sh",
    "test": "python3 tools/check.py && python3 -m unittest discover -s tools/tests",
    "calendar": "python3 tools/factory.py calendar",
    "next": "python3 tools/factory.py next",
    "pick": "python3 tools/factory.py pick",
    "bank": "python3 tools/factory.py bank",
    "build": "python3 tools/factory.py build",
    "review": "python3 tools/factory.py review all",
    "export": "python3 tools/factory.py export",
    "draft": "python3 tools/factory.py draft",
    "lint": "python3 tools/factory.py lint",
    "research-check": "python3 tools/factory.py research-check",
    "repeat-check": "python3 tools/factory.py repeat-check"
  },
  "engines": {
    "node": ">=18"
  }
}
