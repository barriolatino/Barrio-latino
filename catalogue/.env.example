# Base PostgreSQL (Supabase : bouton « Connect » › « Session pooler »).
# Même chaîne pour les deux : la connexion directe de Supabase n'est joignable
# qu'en IPv6, ce que Vercel ne prend pas en charge.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Adresse publique du catalogue (liens partagés, QR code, sitemap)
NEXT_PUBLIC_SITE_URL="https://epicerie.barriolatino.fr"

# Photos : "local" (dossier public/uploads, pour le développement) ou "supabase"
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clé service_role (secrète, jamais dans le navigateur)"
SUPABASE_BUCKET="media"
NEXT_PUBLIC_MEDIA_BASE_URL="https://xxxx.supabase.co/storage/v1/object/public/media"

# Code demandé une seule fois par /admin/setup pour créer le premier compte admin
ADMIN_SETUP_CODE="un code que vous choisissez"

# Connexions à la base par processus (le pooler Supabase gratuit en limite le total)
DATABASE_POOL_MAX="3"

# Premier compte administrateur, en ligne de commande (utilisé par npm run db:seed ou npm run admin:create)
ADMIN_EMAIL="vous@exemple.fr"
ADMIN_PASSWORD="un mot de passe long"

# Facultatif : dossier de photos pour les données de démonstration (<référence>.png)
SEED_IMAGES_DIR=""
