# Base PostgreSQL (Supabase : Project Settings › Database › Connection string)
# DATABASE_URL : chaîne « Session pooler » ; DIRECT_URL : connexion directe (migrations).
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres"

# Adresse publique du catalogue (liens partagés, QR code, sitemap)
NEXT_PUBLIC_SITE_URL="https://epicerie.barriolatino.fr"

# Photos : "local" (dossier public/uploads, pour le développement) ou "supabase"
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clé service_role (secrète, jamais dans le navigateur)"
SUPABASE_BUCKET="media"
NEXT_PUBLIC_MEDIA_BASE_URL="https://xxxx.supabase.co/storage/v1/object/public/media"

# Premier compte administrateur (utilisé par npm run db:seed ou npm run admin:create)
ADMIN_EMAIL="vous@exemple.fr"
ADMIN_PASSWORD="un mot de passe long"

# Facultatif : dossier de photos pour les données de démonstration (<référence>.png)
SEED_IMAGES_DIR=""
